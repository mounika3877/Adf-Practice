{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactorypractice10"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"LS AWS S3_secretAccessKey": {
			"type": "secureString",
			"metadata": "Secure string for 'secretAccessKey' of 'LS AWS S3'"
		},
		"LS_Blob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_Blob'"
		},
		"linkservice adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkservice adls'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresql-server10.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azureSQLDB"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azuresql"
		},
		"LS AKVMysql_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://AKVMysql10.vault.azure.net/"
		},
		"LS AWS S3_properties_typeProperties_accessKeyId": {
			"type": "string",
			"defaultValue": "AKIA3W227AMKWKG6RXA7"
		},
		"LS Github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"LS_Mysql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "127.0.0.1"
		},
		"LS_Mysql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "info"
		},
		"LS_Mysql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"linkservice adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalakestorage10.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactorypractice10_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"LS AWS S3_secretAccessKey": {
						"value": "[parameters('LS AWS S3_secretAccessKey')]"
					},
					"LS_Blob_connectionString": {
						"value": "[parameters('LS_Blob_connectionString')]"
					},
					"linkservice adls_accountKey": {
						"value": "[parameters('linkservice adls_accountKey')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS AKVMysql_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS AKVMysql_properties_typeProperties_baseUrl')]"
					},
					"LS AWS S3_properties_typeProperties_accessKeyId": {
						"value": "[parameters('LS AWS S3_properties_typeProperties_accessKeyId')]"
					},
					"LS Github_properties_typeProperties_url": {
						"value": "[parameters('LS Github_properties_typeProperties_url')]"
					},
					"linkservice adls_properties_typeProperties_url": {
						"value": "[parameters('linkservice adls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "datafactorypractice10_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Mysql_properties_typeProperties_server": {
						"value": "[parameters('LS_Mysql_properties_typeProperties_server')]"
					},
					"LS_Mysql_properties_typeProperties_database": {
						"value": "[parameters('LS_Mysql_properties_typeProperties_database')]"
					},
					"LS_Mysql_properties_typeProperties_username": {
						"value": "[parameters('LS_Mysql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafactorypractice10_ArmTemplate_0')]"
			]
		},
		{
			"name": "datafactorypractice10_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafactorypractice10_ArmTemplate_1')]"
			]
		}
	]
}