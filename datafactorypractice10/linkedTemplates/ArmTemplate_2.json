		{
			"name": "[concat(parameters('factoryName'), '/dataflow transform')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_DL_txtfile",
								"type": "DatasetReference"
							},
							"name": "SourceDL"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Delimitedtext",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "pivot1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ID as string,",
						"          Product as string,",
						"          Sales as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> SourceDL",
						"SourceDL pivot(groupBy(ID),",
						"     pivotBy(Product),",
						"     {total sales} = sum(toInteger(Sales)),",
						"     columnNaming: '$N$V',",
						"     lateral: true) ~> pivot1",
						"pivot1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Ds_dataflow_src",
								"type": "DatasetReference"
							},
							"name": "SourceSalesFiles"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Ds_transformSales_csv",
								"type": "DatasetReference"
							},
							"name": "sinkTransformSalesdata"
						}
					],
					"transformations": [
						{
							"name": "selectcolumns"
						},
						{
							"name": "filter1"
						},
						{
							"name": "splitGeo"
						},
						{
							"name": "aggregateSales"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {Sales Person} as string,",
						"          Geo as string,",
						"          Product as string,",
						"          Ship_Date as string,",
						"          Amount as string,",
						"          Boxes as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> SourceSalesFiles",
						"SourceSalesFiles select(mapColumn(",
						"          {Sales Person},",
						"          Geo,",
						"          Product,",
						"          Ship_Date,",
						"          Amount",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcolumns",
						"selectcolumns filter({Sales Person}!='SP07',",
						"     partitionBy('hash', 1)) ~> filter1",
						"filter1 split(Geo == 'G1',",
						"     Geo == 'G2',",
						"     Geo == 'G3',",
						"     disjoint: false,",
						"     partitionBy('hash', 1)) ~> splitGeo@(G1, G2, G3, other)",
						"splitGeo@G1 aggregate(groupBy({Sales Person}),",
						"     Amount = sum(toInteger(Amount)),",
						"     partitionBy('hash', 1)) ~> aggregateSales",
						"aggregateSales sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkTransformSalesdata"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow2')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Ds_src_scd1",
								"type": "DatasetReference"
							},
							"name": "sourceSCD1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "LS_AZURE_SQl",
								"type": "DatasetReference"
							},
							"name": "sinkSCD1"
						}
					],
					"transformations": [
						{
							"name": "alterRowSCD1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> sourceSCD1",
						"sourceSCD1 alterRow(upsertIf(1==1),",
						"     partitionBy('hash', 1)) ~> alterRowSCD1",
						"alterRowSCD1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     deletable:false,",
						"     insertable:false,",
						"     updateable:false,",
						"     upsertable:true,",
						"     keys:['Employee_ID'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkSCD1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow4')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_src_salesinvoice",
								"type": "DatasetReference"
							},
							"name": "sourcesalesfiles"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Ds_salestransformations",
								"type": "DatasetReference"
							},
							"name": "sinksalesinvoice"
						}
					],
					"transformations": [
						{
							"name": "selectcolumns"
						},
						{
							"name": "filterinvoicevalid"
						},
						{
							"name": "splitcountry"
						},
						{
							"name": "aggregateinvoice"
						}
					],
					"scriptLines": [
						"source(output(",
						"          InvoiceNo as string,",
						"          StockCode as string,",
						"          Description as string,",
						"          Quantity as string,",
						"          InvoiceDate as string,",
						"          UnitPrice as string,",
						"          CustomerID as string,",
						"          Country as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> sourcesalesfiles",
						"sourcesalesfiles select(mapColumn(",
						"          InvoiceNo,",
						"          Quantity,",
						"          InvoiceDate,",
						"          UnitPrice,",
						"          CustomerID,",
						"          Country",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcolumns",
						"selectcolumns filter(InvoiceNo != '537669',",
						"     partitionBy('hash', 1)) ~> filterinvoicevalid",
						"filterinvoicevalid split(Country == 'United Kingdom',",
						"     Country == 'Germany',",
						"     Country == 'Australia',",
						"     disjoint: false,",
						"     partitionBy('hash', 1)) ~> splitcountry@(UK, Germany, Austraila, Other)",
						"splitcountry@UK aggregate(groupBy(InvoiceNo),",
						"     UnitPrice = sum(toInteger(UnitPrice)),",
						"     partitionBy('hash', 1)) ~> aggregateinvoice",
						"aggregateinvoice sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          {Sales Person} as string,",
						"          Amount as string",
						"     ),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinksalesinvoice"
					]
				}
			},
			"dependsOn": []
		},
